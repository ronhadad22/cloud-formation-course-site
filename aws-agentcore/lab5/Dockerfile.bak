# Build stage with compilation tools
FROM public.ecr.aws/lambda/python:3.11 as builder

# Install build dependencies
RUN yum install -y gcc gcc-c++ python3-devel && \
    pip install --upgrade pip setuptools wheel

# Copy and install requirements
COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# Runtime stage
FROM public.ecr.aws/lambda/python:3.11

# Copy installed packages from builder
COPY --from=builder /root/.local/lib/python3.11/site-packages ${LAMBDA_RUNTIME_DIR}

# Copy application code
COPY agent.py ${LAMBDA_TASK_ROOT}

# Set the handler
CMD ["agent.lambda_handler"]
